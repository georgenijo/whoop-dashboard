#!/usr/bin/env bash
# Build and deploy Whoop Dashboard on the Optiplex fleet node (opti), and
# *verify* it landed.
#
# Production layout on opti (verified 2026-08-10):
#   /home/george/Documents/whoop-dashboard/   <- plain git checkout of this repo
#   ├── apps/web/                              <- Next.js app, built in place
#   │   ├── .next/                             <- current build output
#   │   ├── .next.prev/                        <- previous build, kept for rollback
#   │   └── .env.local                         <- secrets (never touched by deploy)
#   ├── shared/whoop_data.db                   <- SQLite DB (snapshotted, never written)
#   └── .env                                   <- secrets (never touched by deploy)
#
# whoop-web.service is a SYSTEM-level systemd unit (not --user), running
# `next start -p 8501 -H 127.0.0.1`, fronted by the shared Cloudflare tunnel
# (no nginx, no certbot). Restarting it requires sudo (passwordless on opti).
#
# Six properties this script exists to guarantee. Each one is here because the
# obvious shortcut fails silently:
#
#   1. SNAPSHOT THE DB FIRST, with SQLite's online-backup API — never `cp`.
#      Schema migrations are lazy ALTERs in openWrite(), so ANY deploy can
#      migrate the DB on the first write after restart.
#   2. INSTALL AND BUILD DETACHED. `npm ci` and `next build` outlive a dropped
#      connection; foreground steps under `fleet exec` do not. A killed build
#      orphans a process that keeps .next's lock; a killed install leaves
#      node_modules half-populated while whoop-web.service is still running
#      and lazily `require()`-ing from that tree, so it 500s until a retry
#      completes — without anyone having touched the service. Both steps use
#      the same setsid + exit-code-sentinel + fresh-connection-poll machinery
#      (see poll_detached_step below).
#   3. VERIFY THE RUNNING SHA, not just that the service is up. Prod once ran
#      three commits behind main for a day with the fix for a live coach-timeout
#      bug merged and undeployed, because nothing reported what was serving.
#   4. PRINT A ROLLBACK RECIPE, including the -wal/-shm deletion, on every exit
#      once a snapshot exists.
#   5. RESOLVE --ref AGAINST THE REMOTE, not against opti's local branches.
#      opti's checkout sits ON local `main` and every deploy `reset --hard`s it
#      to the sha being deployed, so `git rev-parse main^{commit}` there returns
#      the ALREADY-DEPLOYED commit (refs/heads beats refs/remotes in rev-parse's
#      lookup order). `--ref main` therefore used to redeploy the running build
#      and report success: the target resolved, the build ran, sha verification
#      passed, and nothing was updated. Resolution happens ONCE, in phase 0,
#      logs which ref won, and the resulting full sha is what later phases use —
#      so a push landing mid-deploy also cannot swap the commit under us.
#   6. TAKE THE NODE VERSION FROM .nvmrc AT THE DEPLOYED REF. Hardcoding it here
#      recreates issue #500 one layer down: .nvmrc bumps, CI goes green on the
#      new version, and prod silently keeps building on the old one. Read from
#      `git show <target-sha>:.nvmrc` on opti — the deployed ref's own value, not
#      the operator's local checkout (which is usually a different branch, and
#      must never influence what prod builds with). Missing or malformed is
#      FATAL, never a silent fallback; DEPLOY_NODE_VERSION is the escape hatch.
#
# Usage:
#   scripts/deploy              # deploy origin/main
#   scripts/deploy --ref <ref>  # deploy a specific ref (sha, tag or branch)
#   scripts/deploy --check      # report drift only, change nothing
#
# Env overrides: DEPLOY_NODE_VERSION (bypass .nvmrc — needed to deploy a ref
# that predates it), DEPLOY_FLEET_NODE, DEPLOY_APP_ROOT, DEPLOY_REPO_URL.
set -euo pipefail

FLEET_NODE=${DEPLOY_FLEET_NODE:-opti}
APP_ROOT=${DEPLOY_APP_ROOT:-/home/george/Documents/whoop-dashboard}
# Fetch over HTTPS rather than the checkout's configured `origin`. opti's origin
# remote is an SSH URL whose key is not authorized on GitHub, so `git fetch
# origin` fails with "Permission denied (publickey)"; HTTPS resolves through the
# `gh auth git-credential` helper that is already configured on opti.
REPO_URL=${DEPLOY_REPO_URL:-https://github.com/georgenijo/whoop-dashboard.git}
# Empty by default: the real value comes from .nvmrc at the deployed ref, read on
# opti (see property 6). This is only the operator's override.
NODE_VERSION_OVERRIDE=${DEPLOY_NODE_VERSION:-}
PORT=${DEPLOY_PORT:-8501}
PUBLIC_URL=${DEPLOY_PUBLIC_URL:-https://coach-api.georgenijo.com/}
CURSOR_AGENT_BIN=${DEPLOY_CURSOR_AGENT_BIN:-/home/george/.local/bin/cursor-agent}
# Snapshots live OUTSIDE the repo (a stray 6MB .db inside shared/ gets picked up
# by tooling that globs the data dir) and outside any world-readable path — the
# DB is mode 600 health data.
BACKUP_DIR=${DEPLOY_BACKUP_DIR:-/home/george/whoop-db-backups}
BACKUP_KEEP=${DEPLOY_BACKUP_KEEP:-10}
BUILD_POLL_SECONDS=${DEPLOY_BUILD_POLL_SECONDS:-900}   # 15 min ceiling
BUILD_POLL_INTERVAL=${DEPLOY_BUILD_POLL_INTERVAL:-15}
BUILD_LOG=/tmp/whoop-deploy-build.log
BUILD_EXIT=/tmp/whoop-deploy-build.exit
BUILD_SH=/tmp/whoop-deploy-build.sh
# Same machinery, for `npm ci`. Ceiling matches the foreground `fleet exec
# --timeout 900` it replaces.
INSTALL_POLL_SECONDS=${DEPLOY_INSTALL_POLL_SECONDS:-900}
INSTALL_POLL_INTERVAL=${DEPLOY_INSTALL_POLL_INTERVAL:-15}
INSTALL_LOG=/tmp/whoop-deploy-install.log
INSTALL_EXIT=/tmp/whoop-deploy-install.exit
INSTALL_SH=/tmp/whoop-deploy-install.sh

REF=origin/main
CHECK_ONLY=0
while [ $# -gt 0 ]; do
  case "$1" in
    --ref)
      [ $# -ge 2 ] || { echo "--ref needs a value" >&2; exit 2; }
      REF="$2"; shift 2 ;;
    --check) CHECK_ONLY=1; shift ;;
    # Print the header block, however long it happens to be — a hardcoded line
    # range silently truncates the usage text the moment the header grows.
    -h|--help) awk 'NR > 1 { if (!/^#/) exit; print }' "$0"; exit 0 ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done

say() { printf '\n\033[1m==> %s\033[0m\n' "$*"; }
die() { printf '\n\033[31mFAILED: %s\033[0m\n' "$*" >&2; exit 1; }

# Shared poller for a detached remote step (npm ci, next build). Both are
# launched with setsid+nohup so a dropped connection can't kill them, and
# both signal completion by writing their exit code to a sentinel file —
# never by polling for an output file the step itself produces early (e.g.
# next writes .next/BUILD_ID well before prerender finishes; polling for
# that would restart prod into a broken build).
#
# Every poll is a FRESH short-lived `fleet exec`, so a dropped poll costs one
# interval, not the step. A poll failure (empty $rc from a transient
# connection error) is therefore never treated as a result — only an actual
# sentinel value or the ceiling ends the loop, so a hang cannot read as
# success.
#
# $1 label      human-readable name, used in messages only
# $2 exit_file  sentinel path polled for the step's exit code
# $3 log_file   step's stdout+stderr log, referenced in failure messages
# $4 ceiling    seconds to wait before giving up (does not kill the step)
# $5 interval   seconds between polls
# $6 lock_check remote shell snippet that echoes "locked" if a stale-lock
#               orphan is detected in the log; pass "" to skip this check
# $7 outvar     name of the caller's variable to receive the exit code
poll_detached_step() {
  local label=$1 exit_file=$2 log_file=$3 ceiling=$4 interval=$5 lock_check=$6
  local -n _poll_out=$7
  local waited=0 rc=""
  while [ "$waited" -lt "$ceiling" ]; do
    sleep "$interval"
    waited=$((waited + interval))
    rc=$(fleet exec --timeout 60 "$FLEET_NODE" "cat '$exit_file' 2>/dev/null || true" 2>/dev/null \
      | tr -d '[:space:]') || rc=""
    if [ -n "$rc" ]; then
      echo "  $label finished after ${waited}s (exit $rc)"
      _poll_out=$rc
      return 0
    fi
    if [ -n "$lock_check" ] && fleet exec --timeout 60 "$FLEET_NODE" "$lock_check" 2>/dev/null | grep -q locked; then
      die "another $label holds the lock — an orphan from a dropped session is still running.
     Log: fleet exec $FLEET_NODE 'tail -f $log_file'"
    fi
    printf '  ... %ss\n' "$waited"
  done
  die "$label did not finish in ${ceiling}s — it may STILL BE RUNNING.
     Watch it:  fleet exec $FLEET_NODE 'tail -f $log_file'"
}

if [[ ! "$CURSOR_AGENT_BIN" =~ ^/[A-Za-z0-9._/-]+$ ]]; then
  die "DEPLOY_CURSOR_AGENT_BIN must be a safe absolute path"
fi
# REF is the only operator-supplied value interpolated into the remote command
# string. Everything embedded there is single-quoted, so the thing to exclude is
# a quote (or anything else that could terminate the quoting).
if [[ ! "$REF" =~ ^[A-Za-z0-9][A-Za-z0-9._/~^-]*$ ]]; then
  die "--ref must look like a git ref (letters, digits, . _ / ~ ^ -), got: $REF"
fi
# The override is interpolated into a PATH on the node, and into an nvm
# directory name, so it must be an exact x.y.z — `20` or `lts/*` would resolve to
# a directory that does not exist and take the PATH down with it.
if [ -n "$NODE_VERSION_OVERRIDE" ] \
  && [[ ! "$NODE_VERSION_OVERRIDE" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  die "DEPLOY_NODE_VERSION must be an exact version like 20.20.2, got: $NODE_VERSION_OVERRIDE"
fi
NODE_VERSION_OVERRIDE=${NODE_VERSION_OVERRIDE#v}
# The numeric tunables land in `[ -gt ]` and in loop arithmetic, where a
# non-numeric override would either abort mid-deploy or spin forever.
for _var in PORT BACKUP_KEEP BUILD_POLL_SECONDS BUILD_POLL_INTERVAL INSTALL_POLL_SECONDS INSTALL_POLL_INTERVAL; do
  [[ "${!_var}" =~ ^[0-9]+$ ]] || die "$_var must be a non-negative integer, got: ${!_var}"
done
[ "$BUILD_POLL_INTERVAL" -gt 0 ] || die "DEPLOY_BUILD_POLL_INTERVAL must be > 0"
[ "$INSTALL_POLL_INTERVAL" -gt 0 ] || die "DEPLOY_INSTALL_POLL_INTERVAL must be > 0"

command -v fleet >/dev/null 2>&1 || die "fleet CLI is required"

DB_PATH="$APP_ROOT/shared/whoop_data.db"
WEB_DIR="$APP_ROOT/apps/web"
BACKUP_PATH=""      # set once the snapshot lands; gates the rollback recipe
ROLLBACK_SHA=""     # the sha that was deployed BEFORE this run

print_rollback() {
  cat <<EOF

Rollback (SINGLE STEP ONLY — the next deploy overwrites both .next.prev and
takes a fresh snapshot, so this recipe does not stack across deploys):

  # 1. Build-level rollback. Fast, leaves the DB alone. Try this first.
  fleet exec $FLEET_NODE 'cd $WEB_DIR && rm -rf .next && mv .next.prev .next && sudo systemctl restart whoop-web'

  # 2. Code + DB rollback. Only if this deploy migrated the schema.
  fleet exec $FLEET_NODE 'sudo systemctl stop whoop-web'
  # Delete the sidecars FIRST. SIGTERM to node does not guarantee a clean
  # SQLite close, and SQLite validates WAL frames by salt/checksum only — it
  # never checks the WAL belongs to this DB image — so a leftover -wal would
  # replay onto the restored older file and blend two database states.
  # The snapshot is journal_mode=delete; connection.ts puts it back into WAL on
  # the first open, so no extra step is needed after the copy.
  fleet exec $FLEET_NODE 'rm -f $DB_PATH-wal $DB_PATH-shm && cp $BACKUP_PATH $DB_PATH'
  scripts/deploy --ref ${ROLLBACK_SHA:-<previous sha>}

  # The build Node comes from .nvmrc at the ref being deployed. If that sha
  # predates .nvmrc, the redeploy above refuses to guess — pass it explicitly:
  #   DEPLOY_NODE_VERSION=${NODE_VERSION:-20.20.2} scripts/deploy --ref ${ROLLBACK_SHA:-<previous sha>}
EOF
}

on_exit() {
  local rc=$?
  # Only meaningful once a snapshot exists — before that there is nothing to
  # roll back to and nothing has been touched.
  if [ "$rc" -ne 0 ] && [ -n "$BACKUP_PATH" ]; then
    print_rollback
  fi
  return "$rc"
}
trap on_exit EXIT

# --- 0. what is live right now ------------------------------------------------
# Remote phases emit `##KEY=value` lines for this script to parse, plus ordinary
# human output that is re-printed verbatim. Capturing the output costs nothing:
# `fleet exec` buffers a phase's stdout and delivers it on completion, so there
# is no live stream to lose. That buffering is also why the build below is
# polled rather than run inline — the poll loop is the only progress feedback
# available during the slow step.
say "Current state on $FLEET_NODE"
STATE_OUT=$(fleet exec --timeout 180 "$FLEET_NODE" \
  "bash -s -- '$APP_ROOT' '$REPO_URL' '$NODE_VERSION_OVERRIDE' '$CURSOR_AGENT_BIN' '$REF' '$PORT'" <<'REMOTE_STATE'
set -euo pipefail
ROOT=$1
REPO_URL=$2
NODE_OVERRIDE=$3
CURSOR_AGENT_BIN=$4
REF=$5
PORT=$6
cd "$ROOT" || { echo "app root $ROOT not found" >&2; exit 1; }

# The default path fetches exactly the one refspec it needs. A non-default --ref
# may live on another branch, so widen the fetch only then. Tags are fetched too:
# `--ref v1.2.3` has to resolve, and refs/tags is not covered by refs/heads/*.
if [ "$REF" = "origin/main" ]; then
  git fetch -q "$REPO_URL" '+refs/heads/main:refs/remotes/origin/main' \
    || { echo "git fetch failed" >&2; exit 1; }
else
  git fetch -q --tags "$REPO_URL" '+refs/heads/*:refs/remotes/origin/*' \
    || { echo "git fetch failed" >&2; exit 1; }
fi

# Resolve REF to a full sha, preferring the remote-tracking ref over anything
# local. `git rev-parse main^{commit}` searches refs/heads BEFORE refs/remotes,
# and this checkout sits on local `main`, which every deploy reset --hard's to
# the sha it deployed — so a bare `--ref main` resolved to the ALREADY-DEPLOYED
# commit and the whole deploy reported success having changed nothing. Falling
# back to the literal ref only when the origin/ candidate misses is what keeps
# shas (which have no refs/remotes/origin/<sha>) and tags working.
RESOLVED_SHA=""
RESOLVED_FROM=""
resolve_ref() {
  local ref=$1 candidate sha full
  case "$ref" in
    origin/*) candidate="refs/remotes/$ref" ;;
    refs/*)   candidate="$ref" ;;
    *)        candidate="refs/remotes/origin/$ref" ;;
  esac
  if sha=$(git rev-parse --verify -q "${candidate}^{commit}" 2>/dev/null); then
    RESOLVED_SHA=$sha; RESOLVED_FROM=$candidate; return 0
  fi
  # No remote-tracking match. If the literal name is a LOCAL branch, that is the
  # trap above, not a fallback — refuse rather than deploy this box's own state.
  full=$(git rev-parse --symbolic-full-name --verify -q "$ref" 2>/dev/null || true)
  case "$full" in
    refs/heads/*)
      echo "ref '$ref' matches only the local branch $full on $(hostname), and no" >&2
      echo "$candidate exists. Local branches here are reset --hard'd to whatever" >&2
      echo "was last deployed, so this would silently redeploy the running build." >&2
      return 1 ;;
  esac
  if sha=$(git rev-parse --verify -q "${ref}^{commit}" 2>/dev/null); then
    RESOLVED_SHA=$sha; RESOLVED_FROM=${full:-"$ref (literal object)"}; return 0
  fi
  echo "ref '$ref' does not resolve to a commit on $(hostname)" >&2
  return 1
}
resolve_ref "$REF" || exit 1

echo "##DEPLOYED=$(git rev-parse --short HEAD)"
echo "##TARGET=$(git rev-parse --short "$RESOLVED_SHA")"
echo "##TARGET_FULL=$RESOLVED_SHA"
echo "##TARGET_FROM=$RESOLVED_FROM"
echo "##SERVICE=$(systemctl is-active whoop-web.service 2>/dev/null || echo inactive)"
# Informational only: a down service must still let --check report the drift it
# exists to report, so a failed curl is not fatal here. /api/health only reveals
# the sha to direct on-box callers, which is why this runs on the node.
SERVING=$(curl -sS --max-time 10 "http://127.0.0.1:$PORT/api/health" 2>/dev/null \
  | sed -n 's/.*"sha":"\([^"]*\)".*/\1/p' || true)
echo "##SERVING=$SERVING"

# --- which Node builds this ref ---
# From .nvmrc AT THE TARGET SHA, via `git show` — not the working tree (still on
# the OLD commit at this point) and not the operator's laptop. Nothing here is
# fatal: --check must still report drift on a ref that predates .nvmrc. The
# caller decides, and refuses to deploy without a version.
NODE_VERSION=""
NODE_FROM=""
NODE_ERROR=""
if [ -n "$NODE_OVERRIDE" ]; then
  NODE_VERSION=$NODE_OVERRIDE
  NODE_FROM="DEPLOY_NODE_VERSION override"
else
  NVMRC=$(git show "$RESOLVED_SHA:.nvmrc" 2>/dev/null || true)
  if [ -z "$NVMRC" ]; then
    NODE_ERROR=".nvmrc is missing at $RESOLVED_SHA — cannot determine the build Node.
     Deploy a ref that carries .nvmrc, or set DEPLOY_NODE_VERSION=x.y.z explicitly."
  else
    # First non-empty, non-comment line, CR and whitespace stripped, leading v
    # optional. An exact x.y.z is required: the value names an nvm directory, so
    # `20` or `lts/*` would build a PATH that does not exist.
    RAW=$(printf '%s\n' "$NVMRC" | sed -e 's/#.*//' -e 's/[[:space:]]//g' | grep -v '^$' | head -1 || true)
    RAW=${RAW#v}
    if printf '%s' "$RAW" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'; then
      NODE_VERSION=$RAW
      NODE_FROM=".nvmrc@$(git rev-parse --short "$RESOLVED_SHA")"
    else
      NODE_ERROR=".nvmrc at $RESOLVED_SHA is not an exact version (got: '$RAW').
     scripts/deploy needs x.y.z because the value names an nvm directory.
     Fix .nvmrc, or set DEPLOY_NODE_VERSION=x.y.z explicitly."
    fi
  fi
fi

if [ -n "$NODE_VERSION" ]; then
  NODE_BIN="$HOME/.nvm/versions/node/v$NODE_VERSION/bin/node"
  if [ -x "$NODE_BIN" ]; then
    # The service's ExecStart pins its own Node, and better-sqlite3 is compiled
    # against whatever built it. NODE_MODULE_VERSION is per-MAJOR, so a major
    # mismatch is a guaranteed ERR_DLOPEN_FAILED after restart — fatal. A patch
    # difference is ABI-compatible; say so and carry on.
    UNIT_NODE=$(systemctl cat whoop-web.service 2>/dev/null \
      | sed -n 's#^ExecStart=.*/\.nvm/versions/node/v\([0-9][0-9.]*\)/bin/node .*#\1#p' | head -1 || true)
    if [ -n "$UNIT_NODE" ] && [ "$UNIT_NODE" != "$NODE_VERSION" ]; then
      if [ "${UNIT_NODE%%.*}" != "${NODE_VERSION%%.*}" ]; then
        NODE_ERROR="build Node $NODE_VERSION ($NODE_FROM) and the service's own Node $UNIT_NODE
     differ in MAJOR version. better-sqlite3 would be compiled against the wrong
     ABI and the service would come back up with ERR_DLOPEN_FAILED.
     Update systemd/whoop-web.service and reload it, or fix .nvmrc."
        NODE_VERSION=""
      else
        echo "  NOTE: .nvmrc says $NODE_VERSION, whoop-web.service runs $UNIT_NODE (same major, ABI-compatible)."
      fi
    fi
  else
    NODE_ERROR="Node $NODE_VERSION ($NODE_FROM) is not installed at $NODE_BIN.
     Install it on $(hostname):  nvm install $NODE_VERSION"
    NODE_VERSION=""
  fi
fi

echo "##NODE_VERSION=$NODE_VERSION"
echo "##NODE_FROM=$NODE_FROM"
if [ -n "$NODE_ERROR" ]; then
  # Single-line for the ##KEY protocol; the caller re-expands it.
  printf '##NODE_ERROR=%s\n' "$(printf '%s' "$NODE_ERROR" | tr '\n' '\a')"
fi

# The canary needs a working Node; skip it (rather than fail) when there is
# none, so --check still reports drift.
if [ -n "$NODE_VERSION" ]; then
  "$HOME/.nvm/versions/node/v$NODE_VERSION/bin/node" scripts/check-cursor-agent.mjs "$CURSOR_AGENT_BIN"
fi
REMOTE_STATE
) || die "could not inspect $FLEET_NODE"

kv() { printf '%s\n' "$STATE_OUT" | sed -n "s/^##$1=//p" | tail -1; }
CHECKOUT_SHA=$(kv DEPLOYED)
TARGET_SHA=$(kv TARGET)
TARGET_FULL=$(kv TARGET_FULL)
TARGET_FROM=$(kv TARGET_FROM)
SERVING_SHA=$(kv SERVING)
SERVICE_STATE=$(kv SERVICE)
NODE_VERSION=$(kv NODE_VERSION)
NODE_FROM=$(kv NODE_FROM)
NODE_ERROR=$(kv NODE_ERROR | tr '\a' '\n')
[ -n "$CHECKOUT_SHA" ] || die "could not read the deployed sha from $FLEET_NODE"
[ -n "$TARGET_SHA" ]   || die "could not resolve $REF on $FLEET_NODE"
[ -n "$TARGET_FULL" ]  || die "could not resolve $REF to a full sha on $FLEET_NODE"
ROLLBACK_SHA="$CHECKOUT_SHA"

if [ "$REF" = "origin/main" ]; then TARGET_LABEL="origin/main"; else TARGET_LABEL="target ($REF)"; fi
printf '  %-14s %s\n' "deployed:"          "$CHECKOUT_SHA"
printf '  %-14s %s\n' "serving:"           "${SERVING_SHA:-<no sha — service down or pre-health build>}"
printf '  %-14s %s\n' "$TARGET_LABEL:"     "$TARGET_SHA"
# Which ref actually won the resolution. Printed always, because the failure
# this guards against is invisible: everything reports green and nothing moved.
printf '  %-14s %s\n' "resolved via:"      "${TARGET_FROM:-<unknown>}"
if [ -n "$NODE_VERSION" ]; then NODE_LABEL="$NODE_VERSION ($NODE_FROM)"; else NODE_LABEL="<unresolved>"; fi
printf '  %-14s %s\n' "build node:"        "$NODE_LABEL"
printf '  %-14s %s\n' "service:"           "$SERVICE_STATE"
if [ -n "$SERVING_SHA" ] && [ "$SERVING_SHA" != "$CHECKOUT_SHA" ]; then
  echo "  NOTE: checkout != running build. The service is stale; a restart is pending."
fi
# Anything that is not a ##KEY line is the canary's own output.
printf '%s\n' "$STATE_OUT" | grep -v '^##' || true

if [ -n "$NODE_ERROR" ]; then
  printf '\n  NODE: %s\n' "$NODE_ERROR"
fi

if [ "$CHECK_ONLY" = "1" ]; then
  # --check is read-only and must keep reporting drift even when the build Node
  # cannot be resolved (e.g. a ref that predates .nvmrc).
  exit 0
fi

# Deploying without a verified build Node is how you get a service that comes
# back up with ERR_DLOPEN_FAILED. Never fall back to a hardcoded default here:
# a silent default is exactly the drift issue #500 was filed about.
[ -n "$NODE_VERSION" ] || die "cannot determine the Node version to build with.
     $NODE_ERROR"

# --- 1. snapshot the DB -------------------------------------------------------
# NOT `cp`. The DB is WAL mode (connection.ts sets journal_mode = WAL) and the
# service is running and writing throughout — nothing is stopped until step 4.
# Everything committed since the last checkpoint lives only in the -wal sidecar,
# so copying the main file alone yields a backup that can restore as an EMPTY
# database, and a copy straddling a checkpoint can tear it. Both exit 0, so the
# failure is silent precisely when the backup matters. Measured on opti against
# a live writer: `cp` captured 0 of 48 committed rows; `.backup` captured 48.
#
# `VACUUM INTO` runs in a read transaction, so it is consistent against a live
# writer, and — unlike `.backup` — it emits the destination in journal_mode
# `delete`: ONE self-contained file with no -wal/-shm sidecars. That matters
# twice over. A WAL-mode snapshot grows an -shm the moment anything opens it
# read-only (a read-only connection builds the WAL index and cannot remove it on
# close), which makes the artifact three files that must travel together and
# pollutes the backup dir with names the pruner has to distinguish.
#
# `-readonly` guarantees this script can never write the prod DB, and makes a
# wrong or missing DB_PATH fail loudly: a read-write sqlite3 happily CREATES an
# empty source database and snapshots THAT, exiting 0.
say "Snapshotting prod DB"
SNAP_OUT=$(fleet exec --timeout 300 "$FLEET_NODE" \
  "bash -s -- '$DB_PATH' '$BACKUP_DIR' '$BACKUP_KEEP'" <<'REMOTE_SNAPSHOT'
set -euo pipefail
DB=$1
BACKUP_DIR=$2
KEEP=$3

[ -s "$DB" ] || { echo "prod DB missing or empty at $DB" >&2; exit 1; }
mkdir -p -m 700 "$BACKUP_DIR"
TS=$(date +%Y%m%d-%H%M%S)
# The `.sqlite` suffix is load-bearing: it is what the pruner's glob anchors on.
SNAP="$BACKUP_DIR/whoop_data.db.backup.$TS.sqlite"
# `[ -e X ] && { ...; }` would exit 1 under `set -e` on the HAPPY path; use if.
if [ -e "$SNAP" ]; then echo "snapshot target $SNAP already exists" >&2; exit 1; fi

# umask so the artifact is never briefly world-readable; the source DB is 0600
# health data.
(umask 077 && sqlite3 -readonly -cmd '.timeout 30000' "$DB" "VACUUM INTO '$SNAP';") \
  || { echo "sqlite3 VACUUM INTO failed" >&2; exit 1; }
[ -s "$SNAP" ] || { echo "snapshot $SNAP is empty" >&2; exit 1; }

# quick_check returns diagnostic TEXT and exits 0 on a corrupt-but-openable
# file. Printing it would let a corrupt snapshot pass as a valid rollback
# artifact, so assert the exact string.
RESULT=$(sqlite3 -readonly "$SNAP" 'PRAGMA quick_check;' | head -1)
[ "$RESULT" = "ok" ] || { echo "quick_check FAILED on $SNAP: $RESULT" >&2; exit 1; }

# A structurally valid but EMPTY database also passes quick_check. Compare the
# table count against the live DB rather than a hardcoded floor, so this keeps
# working as the schema grows.
SRC_TABLES=$(sqlite3 -readonly "$DB" "SELECT COUNT(*) FROM sqlite_master WHERE type='table';")
TABLES=$(sqlite3 -readonly "$SNAP" "SELECT COUNT(*) FROM sqlite_master WHERE type='table';")
[ "$TABLES" -ge 5 ] || { echo "snapshot has only $TABLES tables — refusing it" >&2; exit 1; }
[ "$TABLES" = "$SRC_TABLES" ] || {
  echo "snapshot has $TABLES tables but the live DB has $SRC_TABLES — refusing it" >&2; exit 1; }

echo "  $(stat -c '%s bytes  %n' "$SNAP")  (quick_check ok, $TABLES tables)"
echo "##SNAPSHOT=$SNAP"

# Prune old snapshots. Deliberately non-fatal: a full backup dir is a chore, a
# failed deploy is an outage.
#
# The glob is anchored on the `.sqlite` suffix and the current snapshot is
# excluded explicitly. An earlier revision globbed `whoop_data.db.backup.*`,
# which also matched the `-wal`/`-shm` sidecars a WAL-mode snapshot sprouts —
# three entries for one backup, so `keep the newest N` deleted the snapshot it
# had just taken and left the sidecars. Parsing `ls` is safe here only because
# these names are generated from a timestamp and contain no spaces.
if [ "$KEEP" -gt 0 ]; then
  STALE=$(ls -1t "$BACKUP_DIR"/whoop_data.db.backup.*.sqlite 2>/dev/null | tail -n "+$((KEEP + 1))" || true)
  if [ -n "$STALE" ]; then
    echo "$STALE" | while IFS= read -r f; do
      if [ "$f" != "$SNAP" ]; then
        rm -f "$f" && echo "  pruned $f" || echo "  WARNING: could not prune $f" >&2
      fi
    done
  fi
fi

# The pruner is the only thing here that deletes, so prove it did not eat the
# artifact the whole deploy is about to rely on.
[ -s "$SNAP" ] || { echo "snapshot $SNAP disappeared after pruning" >&2; exit 1; }
REMOTE_SNAPSHOT
) || die "DB snapshot failed or did not verify — refusing to deploy without a good rollback artifact"

printf '%s\n' "$SNAP_OUT" | grep -v '^##' || true
BACKUP_PATH=$(printf '%s\n' "$SNAP_OUT" | sed -n 's/^##SNAPSHOT=//p' | tail -1)
[ -n "$BACKUP_PATH" ] || die "snapshot reported no path — refusing to continue"

# --- 2. sync code + preflight --------------------------------------------------
say "Syncing $TARGET_SHA ($TARGET_FROM) on $FLEET_NODE"
SYNC_OUT=$(fleet exec --timeout 900 "$FLEET_NODE" \
  "bash -s -- '$APP_ROOT' '$NODE_VERSION' '$REPO_URL' '$CURSOR_AGENT_BIN' '$REF' '$TARGET_FULL'" <<'REMOTE_SYNC'
set -euo pipefail
ROOT=$1
NODE_VERSION=$2
REPO_URL=$3
CURSOR_AGENT_BIN=$4
REF=$5
TARGET=$6

# NODE_VERSION came from .nvmrc at the target ref (phase 0 already checked it is
# installed and ABI-compatible with the service's own Node). A login shell here
# resolves a different one — opti's default is 24.x — and anything touching
# better-sqlite3 built against the wrong ABI dies with ERR_DLOPEN_FAILED.
NODE_BIN_DIR="$HOME/.nvm/versions/node/v$NODE_VERSION/bin"
[ -x "$NODE_BIN_DIR/node" ] || {
  echo "Node $NODE_VERSION is missing at $NODE_BIN_DIR — run: nvm install $NODE_VERSION" >&2
  exit 1
}
export PATH="$NODE_BIN_DIR:$PATH"

cd "$ROOT" || { echo "app root $ROOT not found" >&2; exit 1; }

echo "--- syncing code (git fetch + reset --hard $TARGET, from $REF) ---"
if [ "$REF" = "origin/main" ]; then
  git fetch "$REPO_URL" '+refs/heads/main:refs/remotes/origin/main' || { echo "git fetch failed" >&2; exit 1; }
else
  git fetch --tags "$REPO_URL" '+refs/heads/*:refs/remotes/origin/*' || { echo "git fetch failed" >&2; exit 1; }
fi
# TARGET is the FULL sha phase 0 already resolved, not a re-resolution of REF.
# Resolving once means the ref-lookup-order trap (refs/heads beating
# refs/remotes) is fixed in exactly one place, and a push landing between the
# two phases cannot swap the commit out from under a deploy that already
# printed, snapshotted and reported a different target.
git rev-parse --verify -q "$TARGET^{commit}" >/dev/null \
  || { echo "target $TARGET is not present on $(hostname) after fetch" >&2; exit 1; }
git reset --hard "$TARGET" || { echo "git reset --hard $TARGET failed" >&2; exit 1; }

# Re-derive the sha from the node's own git. Abbreviation length is per-repo and
# core.abbrev is per-machine, so a sha abbreviated locally can legitimately
# differ in length from the same commit abbreviated here — which would fail sha
# verification on a perfectly good deploy. next.config.ts stamps the build with
# `git rev-parse --short HEAD` run in this same checkout, so this is exactly the
# string /api/health will report.
DEPLOY_SHA=$(git rev-parse --short HEAD)
echo "now at $DEPLOY_SHA"
echo "##DEPLOY_SHA=$DEPLOY_SHA"

echo "--- Cursor Agent launcher canary ---"
node scripts/check-cursor-agent.mjs "$CURSOR_AGENT_BIN" || {
  echo "Cursor Agent preflight failed — leaving the running service untouched" >&2
  exit 1
}

cd apps/web || { echo "apps/web missing under $ROOT" >&2; exit 1; }

# Only DECIDE here whether `npm ci` is needed — running it is a separate,
# detached phase below (step 3) so a dropped connection can't kill it
# mid-install and leave node_modules half-populated under the live service.
echo "--- checking dependency install status ---"
LOCKFILE=package-lock.json
MARKER=node_modules/.deploy-lockfile-sha
[ -f "$LOCKFILE" ] || { echo "$LOCKFILE missing" >&2; exit 1; }
NEED_CI=1
if [ -d node_modules ] && [ -f "$MARKER" ] \
  && [ "$(shasum -a 256 "$LOCKFILE" | awk '{print $1}')" = "$(cat "$MARKER")" ]; then
  NEED_CI=0
  echo "lockfile unchanged — will skip npm ci"
fi
echo "##NEED_CI=$NEED_CI"
REMOTE_SYNC
) || die "code sync failed on $FLEET_NODE — the running service is untouched"

printf '%s\n' "$SYNC_OUT" | grep -v '^##' || true
EXPECT_SHA=$(printf '%s\n' "$SYNC_OUT" | sed -n 's/^##DEPLOY_SHA=//p' | tail -1)
[ -n "$EXPECT_SHA" ] || die "could not read the deployed sha from $FLEET_NODE"
# Both shas are `git rev-parse --short` from the SAME checkout, so they agree
# unless the reset landed somewhere other than the target that was reported,
# snapshotted and announced. That must not proceed to install or build.
[ "$EXPECT_SHA" = "$TARGET_SHA" ] \
  || die "checkout is at $EXPECT_SHA but $TARGET_SHA ($TARGET_FROM) was the target"
NEED_CI=$(printf '%s\n' "$SYNC_OUT" | sed -n 's/^##NEED_CI=//p' | tail -1)
[ -n "$NEED_CI" ] || die "could not read dependency-install status from $FLEET_NODE"

# --- 3. dependency install (detached — MUST survive a dropped connection) -----
# `npm ci` mutates node_modules IN PLACE while whoop-web.service is still up
# and serving. A foreground install under `fleet exec` that gets killed by a
# dropped connection leaves node_modules half-populated; the live service can
# still lazily `require()` from that half-built tree, so it 500s until a
# retry completes — without anyone having restarted anything (issue #516).
# Skipped entirely when phase 2 found the lockfile marker still matched.
#
# Reuses poll_detached_step, the same machinery the build below uses. No
# lock-message check (unlike the build's "Another next build process" string,
# npm has no equivalent reliable marker in its log) — the pgrep guard at
# launch is the stacking protection here.
if [ "$NEED_CI" = "1" ]; then
  say "Installing dependencies (detached; ~10-60s typical)"
  fleet exec --timeout 120 "$FLEET_NODE" \
    "bash -s -- '$WEB_DIR' '$NODE_VERSION' '$INSTALL_SH' '$INSTALL_LOG' '$INSTALL_EXIT'" <<'REMOTE_INSTALL_LAUNCH' \
    || die "could not launch the dependency install on $FLEET_NODE"
set -euo pipefail
WEB_DIR=$1
NODE_VERSION=$2
INSTALL_SH=$3
INSTALL_LOG=$4
INSTALL_EXIT=$5
# Same reasoning as the build launcher: re-check here (not just in phase 2)
# because this directory is prepended to the PATH the detached script builds,
# and a missing dir would silently fall through to the login shell's Node
# (24.x on opti), compiling better-sqlite3 against the wrong ABI.
NODE_BIN_DIR="$HOME/.nvm/versions/node/v$NODE_VERSION/bin"
[ -x "$NODE_BIN_DIR/npm" ] || {
  echo "Node $NODE_VERSION is missing at $NODE_BIN_DIR — refusing to install with an unpinned PATH" >&2
  exit 1
}

# Refuse to stack installs: a second `npm ci` racing the first against the
# same node_modules is exactly the corruption this phase exists to prevent.
# Matched on this wrapper's OWN script path, not on 'npm ci' itself — npm's
# process name on the command line depends on how the nvm shim re-execs it,
# which this script does not control, while the wrapper path is guaranteed:
# the detached process's argv is exactly `bash $INSTALL_SH` (setsid/nohup
# exec into it, they don't linger as a wrapper).
#
# The pattern is anchored (^...$) and requires the literal "bash " prefix —
# a bare `pgrep -af "$INSTALL_SH"` self-matches THIS launcher's own argv,
# since $INSTALL_SH is passed to it as a plain positional parameter
# (`bash -s -- ... '$INSTALL_SH' ...`) and would show up in its own `ps`
# line. That is a different self-match than the tailscaled one below —
# caught by testing this against a real stub run, not by inspection.
#
# Filtered for tailscaled too, for the reason the build guard is: fleet's
# transport spawns `tailscaled be-child ... --cmd=<the whole command>`, which
# embeds this script's own source (including the string being grepped for)
# and would otherwise self-match.
RUNNING=$(pgrep -af "^bash $INSTALL_SH\$" 2>/dev/null | grep -v tailscaled || true)
if [ -n "$RUNNING" ]; then
  echo "a dependency install is already running — refusing to start a second one:" >&2
  echo "$RUNNING" >&2
  exit 1
fi

rm -f "$INSTALL_LOG" "$INSTALL_EXIT" "$INSTALL_SH"
cat > "$INSTALL_SH" <<INNER
#!/usr/bin/env bash
export PATH="$NODE_BIN_DIR:\$PATH"
cd "$WEB_DIR" || exit 1
echo "--- npm ci ---"
npm ci
rc=\$?
if [ "\$rc" -eq 0 ]; then
  # Marker written ONLY on success. A killed or failed install leaves it
  # stale (or absent), so the next deploy sees NEED_CI=1 again and retries —
  # the self-heal property #516 already relied on, preserved here.
  mkdir -p node_modules
  shasum -a 256 package-lock.json | awk '{print \$1}' > node_modules/.deploy-lockfile-sha
fi
echo "\$rc" > "$INSTALL_EXIT"
INNER
chmod +x "$INSTALL_SH"
setsid nohup bash "$INSTALL_SH" > "$INSTALL_LOG" 2>&1 < /dev/null &
echo "launched (log: $INSTALL_LOG)"
REMOTE_INSTALL_LAUNCH

  INSTALL_RC=""
  poll_detached_step "npm ci" "$INSTALL_EXIT" "$INSTALL_LOG" \
    "$INSTALL_POLL_SECONDS" "$INSTALL_POLL_INTERVAL" "" INSTALL_RC
  if [ "$INSTALL_RC" != "0" ]; then
    echo "--- last 30 lines of install log ---"
    fleet exec --timeout 60 "$FLEET_NODE" "tail -30 '$INSTALL_LOG' || true" || true
    die "npm ci exited $INSTALL_RC — NOT building or restarting the service.
     node_modules may be half-populated; the running service is untouched and
     the next deploy will retry the install (the lockfile marker was not written).
     Full log: fleet exec $FLEET_NODE 'cat $INSTALL_LOG'"
  fi
fi

# --- 4. build (detached — MUST survive a dropped connection) ------------------
# A foreground `npm run build` under `fleet exec` dies with the connection and
# leaves an orphan holding .next's lock, so the next attempt fails with
# "Another next build process". `setsid` puts the build in its own session, so
# SIGHUP on teardown never reaches it, and the poll below runs over fresh
# short-lived connections — a dropped poll costs one interval, not the build.
#
# Completion is signalled by an EXIT-CODE SENTINEL, not by .next/BUILD_ID. Next
# writes BUILD_ID well before static generation runs, so a build that dies
# during prerender still leaves a BUILD_ID behind; polling for that file would
# happily restart prod into a broken build.
#
# No --max-old-space-size here: that pinned V8's heap for the 956M Oracle VM.
# opti has 7.8G and the default cap is correct.
say "Building (detached; ~2-6 min)"
fleet exec --timeout 120 "$FLEET_NODE" \
  "bash -s -- '$WEB_DIR' '$NODE_VERSION' '$BUILD_SH' '$BUILD_LOG' '$BUILD_EXIT'" <<'REMOTE_BUILD_LAUNCH' \
  || die "could not launch the build on $FLEET_NODE"
set -euo pipefail
WEB_DIR=$1
NODE_VERSION=$2
BUILD_SH=$3
BUILD_LOG=$4
BUILD_EXIT=$5
# Re-check here, not just in the sync phase: this directory is prepended to the
# PATH the detached script builds, and if it does not exist the PATH silently
# falls through to the login shell's Node (24.x on opti) — which compiles
# better-sqlite3 against the wrong ABI and takes the service down on restart.
NODE_BIN_DIR="$HOME/.nvm/versions/node/v$NODE_VERSION/bin"
[ -x "$NODE_BIN_DIR/npm" ] || {
  echo "Node $NODE_VERSION is missing at $NODE_BIN_DIR — refusing to build with an unpinned PATH" >&2
  exit 1
}

# Refuse to stack builds: a second `next build` just blocks on the first one's
# lock. `tailscaled` is filtered out because fleet's transport spawns a
# `tailscaled be-child ... --cmd=<the whole command>` process, so `pgrep -f`
# happily matches the very invocation asking the question.
RUNNING=$(pgrep -af 'next build' 2>/dev/null | grep -v tailscaled || true)
if [ -n "$RUNNING" ]; then
  echo "a 'next build' is already running — refusing to start a second one:" >&2
  echo "$RUNNING" >&2
  exit 1
fi

rm -f "$BUILD_LOG" "$BUILD_EXIT" "$BUILD_SH"
# Staging + restore live INSIDE the detached script so a failed build restores
# the previous .next even if this control session is long gone.
cat > "$BUILD_SH" <<INNER
#!/usr/bin/env bash
export PATH="$NODE_BIN_DIR:\$PATH"
cd "$WEB_DIR" || exit 1
echo "--- staging previous build for rollback ---"
rm -rf .next.prev
if [ -d .next ]; then mv .next .next.prev; fi
echo "--- building (npm run build) ---"
npm run build
rc=\$?
if [ "\$rc" -ne 0 ]; then
  echo "build failed — restoring previous .next" >&2
  rm -rf .next
  if [ -d .next.prev ]; then mv .next.prev .next; fi
fi
echo "\$rc" > "$BUILD_EXIT"
INNER
chmod +x "$BUILD_SH"
setsid nohup bash "$BUILD_SH" > "$BUILD_LOG" 2>&1 < /dev/null &
echo "launched (log: $BUILD_LOG)"
REMOTE_BUILD_LAUNCH

BUILD_RC=""
poll_detached_step "build" "$BUILD_EXIT" "$BUILD_LOG" "$BUILD_POLL_SECONDS" "$BUILD_POLL_INTERVAL" \
  "grep -q 'Another next build process' '$BUILD_LOG' 2>/dev/null && echo locked || true" BUILD_RC
if [ "$BUILD_RC" != "0" ]; then
  echo "--- last 30 lines of build log ---"
  fleet exec --timeout 60 "$FLEET_NODE" "tail -30 '$BUILD_LOG' || true" || true
  die "build exited $BUILD_RC — NOT restarting the service. Previous .next was restored.
     Full log: fleet exec $FLEET_NODE 'cat $BUILD_LOG'"
fi

# --- 5. restart + verify the running sha --------------------------------------
# "The service is up" is not verification: a restart that silently kept serving
# the old bundle also comes up. /api/health reports the sha the build was
# stamped with, and only to direct on-box callers, so the comparison happens on
# the node.
say "Restarting whoop-web and verifying the running build"
fleet exec --timeout 180 "$FLEET_NODE" \
  "bash -s -- '$PORT' '$EXPECT_SHA'" <<'REMOTE_VERIFY' \
  || die "restart or verification failed on $FLEET_NODE — see output above"
set -euo pipefail
PORT=$1
EXPECT_SHA=$2

echo "--- restarting whoop-web.service ---"
sudo systemctl restart whoop-web || { echo "sudo systemctl restart whoop-web failed" >&2; exit 1; }
sleep 3
systemctl is-active --quiet whoop-web || { echo "whoop-web.service is not active after restart" >&2; exit 1; }

echo "--- /api/health sha check ---"
NEW_SHA=""
for _ in $(seq 1 12); do
  NEW_SHA=$(curl -sS --max-time 10 "http://127.0.0.1:$PORT/api/health" 2>/dev/null \
    | sed -n 's/.*"sha":"\([^"]*\)".*/\1/p' || true)
  [ -n "$NEW_SHA" ] && break
  sleep 5
done
echo "  expected: $EXPECT_SHA"
echo "  serving : ${NEW_SHA:-<none>}"

# Silence here means the restart did not pick up the new build (or the build
# predates /api/health). Either way it must not pass as success.
[ -n "$NEW_SHA" ] || {
  echo "/api/health returned no sha — the service is not serving the new build" >&2
  exit 1
}
# Order matters: EXPECT_SHA comes from `git rev-parse` so it can never be
# "unknown", which means an unstamped build fails the equality check below with
# a misleading "the restart did not pick up the build". Check the specific case
# first so it reports its own cause. (Previously this sat AFTER the equality
# check, where it was unreachable.)
[ "$NEW_SHA" != "unknown" ] || {
  echo "/api/health reports sha 'unknown' — the build was not stamped with a commit" >&2
  echo "(next.config.ts runs 'git rev-parse --short HEAD'; check the checkout is a git repo)" >&2
  exit 1
}
[ "$NEW_SHA" = "$EXPECT_SHA" ] || {
  echo "running build is $NEW_SHA but $EXPECT_SHA was deployed — the restart did not pick up the build" >&2
  exit 1
}

echo "--- local health check (expect 307) ---"
LOCAL_CODE=$(curl -s -o /dev/null -w '%{http_code}' --max-time 15 "http://127.0.0.1:$PORT/") || LOCAL_CODE=000
[ "$LOCAL_CODE" = "307" ] || { echo "local health check returned $LOCAL_CODE, expected 307" >&2; exit 1; }
echo "local check ok ($LOCAL_CODE)"
REMOTE_VERIFY

say "Public verification (expect 307)"
PUBLIC_CODE=$(curl -s -o /dev/null -w '%{http_code}' --max-time 20 "$PUBLIC_URL") || PUBLIC_CODE=000
echo "  $PUBLIC_URL : $PUBLIC_CODE"
[ "$PUBLIC_CODE" = "307" ] || die "public verification failed — expected 307, got $PUBLIC_CODE"

say "Deployed $EXPECT_SHA on $FLEET_NODE (was $CHECKOUT_SHA)"
echo "  resolved via: $TARGET_FROM"
echo "  built with:   Node $NODE_VERSION ($NODE_FROM)"
echo "  DB snapshot:  $BACKUP_PATH"
print_rollback
