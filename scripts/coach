#!/usr/bin/env python3
"""coach — CLI for inspecting Whoop Dashboard coach threads on production.

Runs one-shot commands on the Optiplex Fleet node and scoped queries against
the chat_messages / chat_threads / chat_logs tables.
Default target is prod; `--local` reads `shared/whoop_data.db` directly.

See README.md "Coach CLI" section or `coach --help`.
"""

from __future__ import annotations

import argparse
import json
import os
import shlex
import shutil
import sqlite3
import subprocess
import sys
from pathlib import Path
from typing import Any

FLEET_NODE = os.environ.get("COACH_FLEET_NODE", "opti")
PROD_DB_PATH = "/home/george/services/whoop-dashboard/shared/whoop_data.db"

REPO_ROOT = Path(__file__).resolve().parent.parent
LOCAL_DB_PATH = REPO_ROOT / "shared" / "whoop_data.db"

_USE_COLOR = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None


def c(code: str, text: str) -> str:
    if not _USE_COLOR:
        return text
    return f"\033[{code}m{text}\033[0m"


BOLD = lambda s: c("1", s)
DIM = lambda s: c("2", s)
RED = lambda s: c("31", s)
GREEN = lambda s: c("32", s)
YELLOW = lambda s: c("33", s)
BLUE = lambda s: c("34", s)
MAGENTA = lambda s: c("35", s)
CYAN = lambda s: c("36", s)


# ---------- Fleet transport ----------

def fleet_base(command: str) -> list[str]:
    return ["fleet", "exec", FLEET_NODE, command]


def master_alive() -> bool:
    if shutil.which("fleet") is None:
        return False
    r = subprocess.run(
        ["fleet", "doctor", FLEET_NODE],
        capture_output=True, text=True,
    )
    return r.returncode == 0


def cmd_login(_args: argparse.Namespace) -> int:
    if master_alive():
        print(GREEN(f"✓ Fleet node {FLEET_NODE} reachable; no persistent login required"))
        return 0
    print(RED(f"✗ Fleet node {FLEET_NODE} is not reachable; run `fleet doctor {FLEET_NODE}`"), file=sys.stderr)
    return 1


def cmd_logout(_args: argparse.Namespace) -> int:
    print(DIM("(Fleet uses one-shot connections; nothing to close)"))
    return 0


# ---------- Query plumbing ----------

def query_local(sql: str, params: tuple = ()) -> list[dict[str, Any]]:
    if not LOCAL_DB_PATH.exists():
        print(RED(f"✗ local DB not found: {LOCAL_DB_PATH}"), file=sys.stderr)
        sys.exit(1)
    conn = sqlite3.connect(str(LOCAL_DB_PATH))
    conn.row_factory = sqlite3.Row
    try:
        rows = conn.execute(sql, params).fetchall()
    finally:
        conn.close()
    return [dict(r) for r in rows]


def query_remote(sql: str, params: tuple = ()) -> list[dict[str, Any]]:
    if not master_alive():
        print(YELLOW(f"! Fleet node unavailable — run `fleet doctor {FLEET_NODE}`"), file=sys.stderr)
        sys.exit(2)
    py = (
        "import sqlite3, json, sys\n"
        f"conn = sqlite3.connect({PROD_DB_PATH!r})\n"
        "conn.row_factory = sqlite3.Row\n"
        f"sql = {sql!r}\n"
        f"params = {list(params)!r}\n"
        "rows = [dict(r) for r in conn.execute(sql, params).fetchall()]\n"
        "sys.stdout.write(json.dumps(rows, default=str))\n"
    )
    remote_cmd = f"python3 -c {shlex.quote(py)}"
    r = subprocess.run(
        fleet_base(remote_cmd),
        capture_output=True, text=True,
    )
    if r.returncode != 0:
        print(RED(f"✗ remote query failed: {r.stderr.strip()}"), file=sys.stderr)
        sys.exit(r.returncode)
    try:
        return json.loads(r.stdout or "[]")
    except json.JSONDecodeError as e:
        print(RED(f"✗ bad remote JSON: {e}\n{r.stdout[:400]}"), file=sys.stderr)
        sys.exit(1)


def q(args: argparse.Namespace, sql: str, params: tuple = ()) -> list[dict[str, Any]]:
    if args.local:
        return query_local(sql, params)
    return query_remote(sql, params)


def run_remote_shell(cmd: str) -> tuple[int, str, str]:
    """Run an arbitrary shell command on production through Fleet."""
    if not master_alive():
        print(YELLOW(f"! Fleet node unavailable — run `fleet doctor {FLEET_NODE}`"), file=sys.stderr)
        sys.exit(2)
    r = subprocess.run(
        fleet_base(cmd),
        capture_output=True, text=True,
    )
    return r.returncode, r.stdout, r.stderr


# ---------- Block rendering ----------

def role_color(role: str) -> str:
    return {
        "user": CYAN(role.upper()),
        "assistant": MAGENTA(role.upper()),
        "system": DIM(role.upper()),
        "tool": YELLOW(role.upper()),
    }.get(role, role.upper())


def render_blocks(blocks: list[dict[str, Any]], filt: str | None) -> None:
    for b in blocks:
        btype = b.get("type", "unknown")
        if filt == "tools" and btype not in ("tool_use", "tool_result"):
            continue
        if filt == "thinking" and btype != "thinking":
            continue
        if filt == "assistant" and btype != "text":
            continue
        if btype == "text":
            print(b.get("text", ""))
        elif btype == "thinking":
            print(DIM("  [thinking]"))
            for line in (b.get("thinking", "") or "").splitlines():
                print(DIM(f"  │ {line}"))
        elif btype == "tool_use":
            name = b.get("name", "?")
            inp = b.get("input", {})
            print(YELLOW(f"  → tool_use: {name}"))
            print(DIM(f"    input: {json.dumps(inp, indent=2)}"))
        elif btype == "tool_result":
            tid = b.get("tool_use_id", "?")
            content = b.get("content", "")
            if isinstance(content, list):
                content = "\n".join(
                    blk.get("text", "") if isinstance(blk, dict) else str(blk)
                    for blk in content
                )
            print(YELLOW(f"  ← tool_result [{tid[:12]}…]"))
            txt = str(content)
            if len(txt) > 2000:
                txt = txt[:2000] + DIM(f"… (+{len(str(content))-2000} chars)")
            for line in txt.splitlines():
                print(DIM(f"    │ {line}"))
        else:
            print(DIM(f"  [{btype}] {json.dumps(b)[:200]}"))


# ---------- Subcommands ----------

def cmd_thread(args: argparse.Namespace) -> int:
    has_attachments = bool(q(
        args,
        "SELECT 1 FROM sqlite_master WHERE type = 'table' "
        "AND name = 'chat_message_attachments' LIMIT 1",
    ))
    attachment_columns = ""
    if has_attachments:
        attachment_columns = (
            ", (SELECT COUNT(*) FROM chat_message_attachments ma "
            "WHERE ma.message_id = m.id) AS attachment_count"
            ", (SELECT group_concat(ma.attachment_id, ',') "
            "FROM chat_message_attachments ma WHERE ma.message_id = m.id "
            "ORDER BY ma.ordinal) AS attachment_ids"
        )
    sql = (
        "SELECT m.id, m.role, m.content, m.blocks, m.created_at, m.status"
        f"{attachment_columns} FROM chat_messages m WHERE m.thread_id = ?"
    )
    params: tuple = (args.id,)
    if args.since:
        sql += " AND created_at >= ?"
        params = params + (args.since,)
    sql += " ORDER BY id ASC"
    rows = q(args, sql, params)

    if args.json:
        for r in rows:
            if r.get("blocks"):
                try:
                    r["blocks"] = json.loads(r["blocks"])
                except Exception:
                    pass
        print(json.dumps(rows, indent=2, default=str))
        return 0

    thread = q(args, "SELECT id, user_id, title, created_at FROM chat_threads WHERE id = ?", (args.id,))
    if thread:
        t = thread[0]
        print(BOLD(f"Thread #{t['id']}: {t.get('title') or '(untitled)'}"))
        print(DIM(f"  user_id={t['user_id']}  created_at={t['created_at']}  messages={len(rows)}"))
        print()

    filt: str | None = None
    if args.tools:
        filt = "tools"
    elif args.thinking:
        filt = "thinking"
    elif args.assistant:
        filt = "assistant"

    for r in rows:
        role = r["role"]
        if args.user and role != "user":
            continue
        if args.assistant and role != "assistant":
            continue

        ts = r.get("created_at", "")
        status = r.get("status") or ""
        status_str = DIM(f" [{status}]") if status and status != "complete" else ""
        print(f"{DIM(ts)}  {role_color(role)}{status_str}  #{r['id']}")
        if r.get("attachment_count"):
            attachment_ids = (r.get("attachment_ids") or "").split(",")
            print(DIM(
                f"  attachments ({r['attachment_count']}): "
                + ", ".join(attachment_ids)
            ))

        blocks_raw = r.get("blocks")
        if blocks_raw:
            try:
                blocks = json.loads(blocks_raw)
                if isinstance(blocks, list):
                    render_blocks(blocks, filt)
                    print()
                    continue
            except Exception:
                pass

        if not filt or filt == "assistant":
            content = r.get("content") or ""
            for line in content.splitlines():
                print(f"  {line}")
        print()
    return 0


def cmd_threads(args: argparse.Namespace) -> int:
    sql = (
        "SELECT t.id, t.user_id, t.title, t.created_at, t.updated_at, "
        "(SELECT COUNT(*) FROM chat_messages m WHERE m.thread_id = t.id) AS msg_count "
        "FROM chat_threads t"
    )
    where: list[str] = []
    params: tuple = ()
    if args.user is not None:
        where.append("t.user_id = ?")
        params = params + (args.user,)
    if args.source:
        where.append("EXISTS (SELECT 1 FROM chat_logs l WHERE l.thread_id = t.id AND l.source = ?)")
        params = params + (args.source,)
    if where:
        sql += " WHERE " + " AND ".join(where)
    sql += " ORDER BY t.updated_at DESC LIMIT ?"
    params = params + (args.limit,)
    rows = q(args, sql, params)

    if args.json:
        print(json.dumps(rows, indent=2, default=str))
        return 0

    if not rows:
        print(DIM("(no threads)"))
        return 0

    print(BOLD(f"{'ID':>5}  {'USER':>4}  {'MSGS':>4}  {'UPDATED':<19}  TITLE"))
    for r in rows:
        title = (r.get("title") or DIM("(untitled)"))[:80]
        print(f"{r['id']:>5}  {r['user_id']:>4}  {r['msg_count']:>4}  {(r['updated_at'] or '')[:19]:<19}  {title}")
    return 0


def cmd_search(args: argparse.Namespace) -> int:
    needle = f"%{args.query}%"
    sql = (
        "SELECT m.id, m.thread_id, m.role, m.created_at, "
        "substr(m.content, 1, 200) AS snippet, t.title "
        "FROM chat_messages m LEFT JOIN chat_threads t ON t.id = m.thread_id "
        "WHERE m.content LIKE ? OR m.blocks LIKE ? "
        "ORDER BY m.id DESC LIMIT ?"
    )
    rows = q(args, sql, (needle, needle, args.limit))

    if args.json:
        print(json.dumps(rows, indent=2, default=str))
        return 0

    if not rows:
        print(DIM("(no matches)"))
        return 0

    for r in rows:
        head = f"#{r['id']} thread={r['thread_id']} {role_color(r['role'])} {DIM(r['created_at'] or '')}"
        print(head)
        if r.get("title"):
            print(DIM(f"  thread: {r['title']}"))
        snippet = (r.get("snippet") or "").replace("\n", " ⏎ ")
        print(f"  {snippet}")
        print()
    return 0


def cmd_logs(args: argparse.Namespace) -> int:
    sql = (
        "SELECT id, started_at, duration_ms, status, response_length, "
        "error_message, type, source, days_context, substr(prompt_preview, 1, 120) AS preview "
        "FROM chat_logs WHERE thread_id = ? ORDER BY id ASC"
    )
    rows = q(args, sql, (args.thread_id,))

    if args.json:
        print(json.dumps(rows, indent=2, default=str))
        return 0

    if not rows:
        print(DIM("(no chat_logs rows for that thread)"))
        return 0

    print(BOLD(f"chat_logs for thread #{args.thread_id}  ({len(rows)} rows)"))
    print()
    for r in rows:
        status = r.get("status") or ""
        status_str = GREEN(status) if status in ("ok", "success") else RED(status) if status else ""
        print(f"  #{r['id']}  {DIM(r['started_at'] or '')}  {status_str}  {r['duration_ms']}ms  "
              f"resp={r['response_length']}  type={r.get('type') or '-'}  src={r.get('source') or '-'}")
        if r.get("preview"):
            print(DIM(f"    » {r['preview']}"))
        if r.get("error_message"):
            print(RED(f"    error: {r['error_message']}"))
    return 0


def cmd_chat_detail(args: argparse.Namespace) -> int:
    rows = q(args,
        "SELECT * FROM chat_logs WHERE id = ?",
        (args.log_id,),
    )
    if not rows:
        print(DIM(f"(no chat_logs row with id={args.log_id})"))
        return 0
    row = rows[0]

    details_raw = row.get("details")
    parsed_details: Any = None
    if details_raw:
        try:
            parsed_details = json.loads(details_raw)
        except Exception:
            parsed_details = details_raw

    if args.json:
        out = dict(row)
        out["details"] = parsed_details
        print(json.dumps(out, indent=2, default=str))
        return 0

    status = row.get("status") or ""
    status_str = GREEN(status) if status in ("ok", "success") else RED(status) if status else ""
    print(BOLD(f"chat_logs #{row['id']}  thread={row.get('thread_id')}  {status_str}"))
    print(DIM(f"  started_at: {row.get('started_at')}"))
    print(DIM(f"  duration:   {row.get('duration_ms')}ms"))
    print(DIM(f"  response:   {row.get('response_length')} chars"))
    print(DIM(f"  type/src:   {row.get('type') or '-'} / {row.get('source') or '-'}"))
    if row.get("prompt_preview"):
        print(DIM(f"  preview:    {row['prompt_preview']}"))
    if row.get("error_message"):
        print(RED(f"  error:      {row['error_message']}"))
    if parsed_details:
        print(BOLD("\ndetails:"))
        if isinstance(parsed_details, dict):
            for k, v in parsed_details.items():
                if isinstance(v, dict):
                    print(f"  {k}:")
                    for k2, v2 in v.items():
                        print(f"    {k2}: {v2}")
                else:
                    print(f"  {k}: {v}")
        else:
            print(f"  {parsed_details}")
    return 0


def cmd_journal(args: argparse.Namespace) -> int:
    if args.local:
        print(YELLOW("! --local has no journalctl; --local ignored for `journal`"), file=sys.stderr)
    until_clause = f" --until {shlex.quote(args.until)}" if args.until else ""
    grep_clause = f" | grep -iE {shlex.quote(args.grep)}" if args.grep else ""
    cmd = (
        f"journalctl --user -u whoop-web "
        f"--since {shlex.quote(args.since)}{until_clause} "
        f"--no-pager{grep_clause}"
    )
    rc, out, err = run_remote_shell(cmd)
    if rc != 0 and not out:
        print(RED(f"✗ journalctl failed: {err.strip()}"), file=sys.stderr)
        return rc
    sys.stdout.write(out)
    return 0


def cmd_settings(args: argparse.Namespace) -> int:
    cols = (
        "user_id, anthropic_key_version, model_pref, timezone, tz, "
        "monthly_token_cap, coach_goals, onboarded_at, updated_at, "
        "(CASE WHEN anthropic_key IS NULL THEN 0 ELSE 1 END) AS anthropic_key_set"
    )
    sql = f"SELECT {cols} FROM user_settings"
    params: tuple = ()
    if args.user is not None:
        sql += " WHERE user_id = ?"
        params = (args.user,)
    sql += " ORDER BY user_id ASC"
    rows = q(args, sql, params)

    if args.json:
        print(json.dumps(rows, indent=2, default=str))
        return 0

    if not rows:
        print(DIM("(no user_settings rows)"))
        return 0

    for r in rows:
        print(BOLD(f"user_settings #{r['user_id']}"))
        print(f"  anthropic_key_set:     {GREEN('yes') if r.get('anthropic_key_set') else DIM('no')}")
        print(f"  anthropic_key_version: {r.get('anthropic_key_version') if r.get('anthropic_key_version') is not None else '-'}")
        print(f"  model_pref:            {r.get('model_pref') or '-'}")
        print(f"  tz:                    {r.get('tz') or r.get('timezone') or '-'}")
        print(f"  monthly_token_cap:     {r.get('monthly_token_cap') if r.get('monthly_token_cap') is not None else '-'}")
        print(f"  coach_goals:           {r.get('coach_goals') or '-'}")
        print(f"  onboarded_at:          {r.get('onboarded_at') or '-'}")
        print(f"  updated_at:            {r.get('updated_at') or '-'}")
        print()
    return 0


def cmd_why(args: argparse.Namespace) -> int:
    """Forensic: cross-join chat_logs + journalctl + user_settings for a thread."""
    logs = q(args,
        "SELECT * FROM chat_logs WHERE thread_id = ? ORDER BY id ASC",
        (args.thread_id,),
    )
    if not logs:
        print(DIM(f"(no chat_logs rows for thread {args.thread_id})"))
        return 0

    threads = q(args,
        "SELECT id, user_id, title, created_at FROM chat_threads WHERE id = ?",
        (args.thread_id,),
    )
    thread = threads[0] if threads else None

    last = logs[-1]
    started = last.get("started_at") or ""
    duration_ms = last.get("duration_ms") or 0
    status = last.get("status") or ""

    print(BOLD(f"Forensics — thread #{args.thread_id}"))
    if thread:
        print(DIM(f"  title: {thread.get('title') or '(untitled)'}"))
        print(DIM(f"  user:  {thread.get('user_id')}  created {thread.get('created_at')}"))
    print()

    print(BOLD(f"chat_logs ({len(logs)} rows)"))
    for r in logs:
        s = r.get("status") or ""
        s_str = GREEN(s) if s in ("ok", "success") else RED(s) if s else ""
        print(f"  #{r['id']}  {DIM(r.get('started_at') or '')}  {s_str:<14}  {r.get('duration_ms')}ms  src={r.get('source') or '-'}")
        details_raw = r.get("details")
        if details_raw:
            try:
                d = json.loads(details_raw)
                usage = d.get("usage") if isinstance(d, dict) else None
                if usage:
                    print(DIM(
                        f"    iters={d.get('iterations',0)} "
                        f"calls={usage.get('calls',0)} "
                        f"in={usage.get('input_tokens_total',0)} "
                        f"out={usage.get('output_tokens_total',0)} "
                        f"cache_w={usage.get('cache_creation_input_tokens_total',0)} "
                        f"cache_r={usage.get('cache_read_input_tokens_total',0)}"
                    ))
                tools = d.get("tools") if isinstance(d, dict) else None
                if tools:
                    print(DIM(f"    tools: {', '.join(tools)}"))
            except Exception:
                pass
        if r.get("error_message"):
            print(RED(f"    error: {r['error_message']}"))
    print()

    # user_settings updated_at delta — was a key/setting rotated near this call?
    if thread:
        ss = q(args,
            "SELECT updated_at, anthropic_key_version FROM user_settings WHERE user_id = ?",
            (thread["user_id"],),
        )
        if ss:
            print(BOLD("user_settings"))
            print(f"  updated_at:            {ss[0].get('updated_at')}")
            print(f"  anthropic_key_version: {ss[0].get('anthropic_key_version')}")
            try:
                from datetime import datetime
                def parse(ts: str) -> datetime:
                    return datetime.fromisoformat(ts.replace("Z", "+00:00"))
                if started and ss[0].get("updated_at"):
                    delta = (parse(started) - parse(ss[0]["updated_at"])).total_seconds()
                    if 0 < delta < 3600:
                        print(YELLOW(
                            f"  ⚠ settings changed {delta:.0f}s before this turn — "
                            "new key = cold Anthropic prompt cache (cache_w > 0, cache_r = 0)"
                        ))
            except Exception:
                pass
            print()

    # Pull journalctl window around the last turn
    if not args.local and started and duration_ms:
        try:
            from datetime import datetime, timedelta
            def parse(ts: str) -> datetime:
                return datetime.fromisoformat(ts.replace("Z", "+00:00"))
            start_dt = parse(started) - timedelta(seconds=2)
            end_dt = parse(started) + timedelta(milliseconds=duration_ms + 5000)
            since = start_dt.strftime("%Y-%m-%d %H:%M:%S")
            until = end_dt.strftime("%Y-%m-%d %H:%M:%S")
            print(BOLD(f"journalctl whoop-web  {since} → {until}  (UTC)"))
            cmd = (
                f"journalctl --user -u whoop-web --since {shlex.quote(since)} "
                f"--until {shlex.quote(until)} --no-pager 2>&1 | "
                f"grep -iE 'chat|thread|sonnet|anthropic|cache|stream|error' | head -40"
            )
            rc, out, _err = run_remote_shell(cmd)
            if out.strip():
                for line in out.splitlines():
                    print(DIM(f"  {line}"))
            else:
                print(DIM("  (no matching lines)"))
        except Exception as e:
            print(DIM(f"  (journalctl skipped: {e})"))
    return 0


def cmd_syncs(args: argparse.Namespace) -> int:
    sql = (
        "SELECT id, started_at, duration_ms, status, source, recovery_count, "
        "sleep_count, workouts_count, partial, error_message, details "
        "FROM sync_logs"
    )
    where: list[str] = []
    params: tuple = ()
    if args.source:
        where.append("source = ?")
        params = params + (args.source,)
    if args.status:
        where.append("status = ?")
        params = params + (args.status,)
    if where:
        sql += " WHERE " + " AND ".join(where)
    sql += " ORDER BY id DESC LIMIT ?"
    params = params + (args.limit,)
    rows = q(args, sql, params)

    if args.json:
        print(json.dumps(rows, indent=2, default=str))
        return 0

    if not rows:
        print(DIM("(no sync_logs rows)"))
        return 0

    print(BOLD(f"{'ID':>5}  {'STARTED (UTC)':<24}  {'SOURCE':<8}  {'STATUS':<8}  {'MS':>6}  REC/SLP/WKT"))
    for r in rows:
        status = r.get("status") or ""
        status_str = GREEN(status) if status == "ok" else RED(status) if status == "error" else YELLOW(status)
        counts = (
            f"{r.get('recovery_count') if r.get('recovery_count') is not None else '-':>3}/"
            f"{r.get('sleep_count') if r.get('sleep_count') is not None else '-':>3}/"
            f"{r.get('workouts_count') if r.get('workouts_count') is not None else '-':>3}"
        )
        partial = YELLOW("  partial") if r.get("partial") else ""
        src = (r.get("source") or "-")[:8]
        print(f"{r['id']:>5}  {(r['started_at'] or '')[:23]:<24}  {src:<8}  {status_str:<17}  {r['duration_ms']:>6}  {counts}{partial}")
        if r.get("error_message"):
            print(RED(f"       error: {r['error_message']}"))
    return 0


# ---------- CLI ----------

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="coach",
        description="Inspect Whoop Dashboard coach threads on production opti (or --local).",
    )
    p.add_argument("--local", action="store_true",
                   help="Query local shared/whoop_data.db instead of production opti")

    sub = p.add_subparsers(dest="command", required=True)

    sub.add_parser("login", help="Compatibility check for Fleet node reachability").set_defaults(func=cmd_login)
    sub.add_parser("logout", help="Compatibility no-op; Fleet connections are one-shot").set_defaults(func=cmd_logout)

    t = sub.add_parser("thread", help="Print full transcript for a thread")
    t.add_argument("id", type=int, help="thread_id")
    t.add_argument("--tools", action="store_true", help="only tool_use + tool_result blocks")
    t.add_argument("--user", action="store_true", help="only user messages")
    t.add_argument("--assistant", action="store_true", help="only assistant text")
    t.add_argument("--thinking", action="store_true", help="only thinking blocks")
    t.add_argument("--json", action="store_true", help="raw JSON dump (blocks decoded)")
    t.add_argument("--since", help="filter messages by created_at >= TS (YYYY-MM-DD or ISO)")
    t.set_defaults(func=cmd_thread)

    ts = sub.add_parser("threads", help="List threads (newest first)")
    ts.add_argument("--user", type=int, help="filter by user_id")
    ts.add_argument("--source", choices=["ios", "web", "api"],
                    help="filter to threads with at least one chat_logs row from this source")
    ts.add_argument("--limit", type=int, default=20)
    ts.add_argument("--json", action="store_true")
    ts.set_defaults(func=cmd_threads)

    s = sub.add_parser("search", help="Grep across chat_messages content + blocks")
    s.add_argument("query", help="substring to match")
    s.add_argument("--limit", type=int, default=20)
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_search)

    lg = sub.add_parser("logs", help="chat_logs rows (timing/status) for a thread")
    lg.add_argument("thread_id", type=int)
    lg.add_argument("--json", action="store_true")
    lg.set_defaults(func=cmd_logs)

    sy = sub.add_parser("syncs", help="Recent sync_logs rows (Whoop syncs)")
    sy.add_argument("--source", help="filter by source (manual|webhook|cron|ios|...)")
    sy.add_argument("--status", choices=["ok", "error", "skipped", "partial"],
                    help="filter by status")
    sy.add_argument("--limit", type=int, default=20)
    sy.add_argument("--json", action="store_true")
    sy.set_defaults(func=cmd_syncs)

    cd = sub.add_parser("chat-detail", help="Full chat_logs row + parsed details JSON")
    cd.add_argument("log_id", type=int, help="chat_logs.id")
    cd.add_argument("--json", action="store_true")
    cd.set_defaults(func=cmd_chat_detail)

    jr = sub.add_parser("journal", help="journalctl whoop-web on production opti")
    jr.add_argument("since", help="--since TS (e.g. '2026-05-21 03:35:00' or '5 min ago')")
    jr.add_argument("--until", help="--until TS")
    jr.add_argument("--grep", help="extended-regex filter (case-insensitive)")
    jr.set_defaults(func=cmd_journal)

    se = sub.add_parser("settings", help="user_settings row (key redacted)")
    se.add_argument("--user", type=int, help="filter by user_id")
    se.add_argument("--json", action="store_true")
    se.set_defaults(func=cmd_settings)

    wh = sub.add_parser("why", help="Forensic: chat_logs + journalctl + user_settings delta for a thread")
    wh.add_argument("thread_id", type=int)
    wh.set_defaults(func=cmd_why)

    return p


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
