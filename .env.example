WHOOP_CLIENT_ID=your_client_id_here
WHOOP_CLIENT_SECRET=your_client_secret_here

# Optional overrides. The redirect defaults to localhost for development and
# the DB defaults to ../../shared/whoop_data.db from apps/web.
# WHOOP_REDIRECT_URI=https://coach.georgenijo.com/api/auth/callback
# WHOOP_DB_PATH=/home/george/Documents/whoop-dashboard/shared/whoop_data.db

# HMAC signing key for the Whoop OAuth `state` nonce. Carries the signed-in
# user_id across the Whoop authorize redirect so the callback knows which
# user is connecting. Required for the Connect-Whoop flow; if unset, the
# start route throws and Connect Whoop fails closed.
# Generate with: openssl rand -base64 32
#   (equivalent: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`)
WHOOP_STATE_SECRET=

# Session JWT signing key (base64-encoded, 32+ random bytes).
# Generate with: openssl rand -base64 32
JWT_SIGNING_KEY=

# Vault key — base64-encoded 32-byte symmetric key. Used by
# apps/web/src/lib/crypto/vault.ts (Node) and streamlit/whoop/vault.py
# (Python) to encrypt OAuth tokens (`integrations` table) and BYOK API
# keys (`user_settings.anthropic_key` / `cursor_key`). Wire format: NaCl
# secretbox.
# Generate with: openssl rand -base64 32
#   (equivalent: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`)
# Rotating this key invalidates every encrypted row — pair with a
# re-encrypt-and-bump-key_version migration before changing in prod.
VAULT_KEY=

# Optional shared Coach fallbacks. A user's encrypted BYOK key takes
# precedence when set in Settings.
ANTHROPIC_API_KEY=
CURSOR_API_KEY=

# Optional comma-separated hosts allowed to load the Next.js dev server.
# Useful when exposing a local preview over a private tailnet.
# COACH_DEV_ORIGINS=100.x.y.z,dev-machine.example.ts.net

# Absolute cursor-agent path for service accounts whose PATH omits ~/.local/bin.
# COACH_CURSOR_AGENT_BIN=/home/george/.local/bin/cursor-agent

# Canonical public origin used to build redirect URLs (sign-out, OAuth
# callbacks, etc). Behind nginx + Cloudflare Access, Next.js's
# `req.nextUrl.origin` resolves to the upstream listener (e.g.
# `https://localhost:8501`) because Next doesn't trust X-Forwarded-* headers.
# Set this on the VM to the user-facing origin (NO trailing slash, NO path).
# Falls back to `req.nextUrl.origin` in local dev.
# PUBLIC_ORIGIN=https://coach.georgenijo.com

# Apple subject allowed to invoke admin-only operations such as webhook replay.
# Fails closed when unset.
# ADMIN_APPLE_SUB=

# Structured log verbosity. Defaults to "info" in production and "debug"
# elsewhere.
# LOG_LEVEL=info

# How far back the per-sync cycles reconcile (issue #415) looks for recovery
# rows with no matching cycles row. Defaults to 30 days. The band's recent end
# is trimmed by the sync's own fetch window (7 days), which the sync just
# covered, so the default effectively scans [today-30, today-7].
# Dates orphaned before this feature shipped are handled separately by a
# one-time backfill over the full recovery history, guarded by a per-user
# `app_settings` marker (`cycles_backfill_v1:user:<id>`) — you should not need
# to widen this to heal history. Raise it only if syncs are expected to lapse
# for more than ~3 weeks at a time. Non-numeric or <= 0 falls back to 30.
# CYCLES_RECONCILE_LOOKBACK_DAYS=30

# iOS bundle identifier — used as the `aud` claim when verifying
# Sign in with Apple identity tokens minted from the iOS native flow.
APPLE_BUNDLE_ID=com.georgenijo.coach

# --- Sign in with Apple — WEB flow (issue #262) -------------------------------
# Setting APPLE_SERVICES_ID is the kill-switch that activates the web auth
# proxy. Until ALL FOUR APPLE_* vars below are set, the proxy ships dormant
# (no /signin redirects) and /api/auth/apple-web/* returns 503.

# Services ID created in Apple Developer console (Identifiers → Services IDs).
# Used as the OAuth client_id AND as the `aud` claim on the resulting id_token.
APPLE_SERVICES_ID=

# Apple Developer Team ID (10-char alphanumeric). Used as `iss` of the
# server-signed client_secret JWT.
APPLE_TEAM_ID=P2U3P8B923

# Key ID (10-char) of the .p8 private key registered for Sign in with Apple.
APPLE_KEY_ID=

# .p8 private key contents. Either the raw PEM block (BEGIN PRIVATE KEY...END
# PRIVATE KEY, including newlines preserved by your env-loader) OR the same
# PEM base64-encoded as a single line (recommended for env-var portability).
APPLE_PRIVATE_KEY=

# Optional override for the Apple OAuth redirect URI. Defaults to
# `${origin}/api/auth/apple-web/callback`. Set this when running behind a
# tunnel / CDN whose public hostname differs from `request.nextUrl.origin`.
# APPLE_REDIRECT_URI=https://coach.georgenijo.com/api/auth/apple-web/callback

# --- APNs (Apple Push Notification service, issue #274a) ----------------------
# All five vars below must be set for push to be available. Until
# APNS_KEY_ID is set, /api/devices/register accepts tokens but no push is
# ever sent — useful for dogfooding the registration flow before the .p8
# is provisioned. Provisioning steps live in the #274a PR description.

# Key ID of the APNs Auth Key (.p8) created in App Store Connect. 10-char.
APNS_KEY_ID=

# Apple Developer Team ID. Same value as APPLE_TEAM_ID above.
APNS_TEAM_ID=P2U3P8B923

# Bundle ID of the iOS target — APNs uses this as the `apns-topic` header.
APNS_BUNDLE_ID=com.georgenijo.coach

# .p8 private key contents (raw PEM or base64 of the PEM). Same format as
# APPLE_PRIVATE_KEY — the file Apple emits is identical in both cases.
APNS_PRIVATE_KEY=

# Which APNs environment to target: "production" or "development".
# TestFlight + App Store builds use "production". Xcode-direct debug
# builds use "development". The iOS entitlement value is "development"
# in source; Apple's signing pipeline promotes it to production for
# AdHoc/AppStore archives, so set this to "production" on the VM.
APNS_ENVIRONMENT=production

# Optional debug flag. Set to "1" only to expose /api/devices/test-push
# in production. Returns 404 unless set. NEVER ship "1" to prod by default
# — even though the route is bearer-authed, an enabled debug surface is
# noise the user shouldn't have to think about.
# ENABLE_PUSH_DEBUG=0
