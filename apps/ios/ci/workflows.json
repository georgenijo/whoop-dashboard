  "beta": {
    "id": "331CD557-A605-4CA8-85CC-9D80A00F3ACB",
    "attributes": {
      "name": "Beta",
      "isEnabled": true,
      "clean": true,
      "containerFilePath": "apps/ios/Coach.xcodeproj",
      "branchStartCondition": {
        "source": {
          "isAllMatch": false,
          "patterns": [
            {
              "pattern": "main",
              "isPrefix": false
            }
          ]
        },
        "filesAndFoldersRule": {
          "mode": "START_IF_ANY_FILE_MATCHES",
          "matchers": [
            {
              "directory": "apps/ios",
              "fileExtension": null,
              "fileName": null
            }
          ]
        },
        "autoCancel": true
      }
    },
    "archiveAction": {
      "name": "Archive - iOS",
      "actionType": "ARCHIVE",
      "buildDistributionAudience": "INTERNAL_ONLY",
      "scheme": "Coach",
      "platform": "IOS",
      "isRequiredToPass": true
    }
  },
  "verify": {
    "attributes": {
      "name": "Verify",
      "description": "Native iOS PR tests and daily pinned-toolchain health check",
      "pullRequestStartCondition": {
        "source": {
          "isAllMatch": true
        },
        "destination": {
          "isAllMatch": false,
          "patterns": [
            {
              "pattern": "main",
              "isPrefix": false
            }
          ]
        },
        "filesAndFoldersRule": {
          "mode": "START_IF_ANY_FILE_MATCHES",
          "matchers": [
            {
              "directory": "apps/ios"
            }
          ]
        },
        "autoCancel": true
      },
      "scheduledStartCondition": {
        "source": {
          "isAllMatch": false,
          "patterns": [
            {
              "pattern": "main",
              "isPrefix": false
            }
          ]
        },
        "schedule": {
          "frequency": "DAILY",
          "hour": 7,
          "minute": 0,
          "timezone": "UTC"
        }
      },
      "isEnabled": true,
      "clean": true,
      "containerFilePath": "apps/ios/Coach.xcodeproj"
    },
    "testAction": {
      "name": "Test - iOS",
      "actionType": "TEST",
      "destination": "ANY_IOS_SIMULATOR",
      "testConfiguration": {
        "kind": "USE_SCHEME_SETTINGS",
        "testDestinations": [
          {
            "deviceTypeName": "iPhone Duo",
            "deviceTypeIdentifier": "com.apple.CoreSimulator.SimDeviceType.iPhone-Duo",
            "runtimeName": "iOS 27.2",
            "runtimeIdentifier": "com.apple.CoreSimulator.SimRuntime.iOS-27-2-iPhone19-4",
            "kind": "SIMULATOR"
          }
        ]
      },
      "scheme": "Coach",
      "platform": "IOS",
      "isRequiredToPass": true
    }
