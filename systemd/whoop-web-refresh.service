[Unit]
Description=Whoop refresh-only keepalive (#273)
After=network-online.target whoop-web.service
Wants=network-online.target
Requires=whoop-web.service

[Service]
Type=oneshot
User=george
# WHOOP_REFRESH_SECRET is supplied by a root-owned, mode-600 EnvironmentFile
# at /etc/whoop-web-refresh.env on opti. That file is deliberately NOT
# checked into this repository — see docs/decisions/DECISIONS.md
# (2026-08-17) and the PR that introduced this unit for install steps.
EnvironmentFile=/etc/whoop-web-refresh.env
# Wrapped in `sh -c` so the shell (not systemd's limited ExecStart word
# splitting) expands ${WHOOP_REFRESH_SECRET} from the EnvironmentFile above.
ExecStart=/bin/sh -c 'exec /usr/bin/curl --fail --silent --show-error --max-time 10 -X POST -H "Authorization: Bearer ${WHOOP_REFRESH_SECRET}" http://127.0.0.1:8501/api/whoop/refresh'
NoNewPrivileges=yes
PrivateTmp=true
ProtectSystem=full
