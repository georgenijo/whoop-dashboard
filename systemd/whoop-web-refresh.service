[Unit]
Description=Whoop refresh-only keepalive (#273)
After=network-online.target whoop-web.service
Wants=network-online.target
# After=, not Requires=/Wants=<service>: ordering only. A Requires= on a
# timer-triggered oneshot would actively START whoop-web every 30 minutes,
# including while an operator has deliberately stopped it for maintenance.

[Service]
Type=oneshot
User=george
# The Authorization header is read from a root-owned, mode-600 file by curl
# itself (`-H @file`, curl >=7.55) — NOT expanded into the command line.
# A secret placed in ExecStart's argv (via `${VAR}` expansion, whether done
# by systemd natively from an EnvironmentFile or by wrapping in `sh -c`)
# is world-readable for the life of the process via /proc/<pid>/cmdline and
# `ps auxww`, 48 times a day. Full install steps, including how this header
# file and the app's own WHOOP_REFRESH_SECRET stay in sync, are in
# docs/operations/environment-and-deploy.md — NOT in the decisions log.
ExecStart=/usr/bin/curl --fail --silent --show-error --max-time 25 -o /dev/null -X POST -H @/etc/whoop-web-refresh.header http://127.0.0.1:8501/api/whoop/refresh
NoNewPrivileges=yes
PrivateTmp=true
ProtectSystem=full
