[Unit]
Description=Whoop Dashboard (Next.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=george
WorkingDirectory=/home/george/Documents/whoop-dashboard/apps/web
ExecStart=/home/george/.nvm/versions/node/v20.20.2/bin/node node_modules/.bin/next start -p 8501 -H 127.0.0.1
Restart=always
RestartSec=5
MemoryMax=512M
Environment=NODE_ENV=production
Environment=PATH=/home/george/.nvm/versions/node/v20.20.2/bin:/usr/bin:/usr/local/bin
NoNewPrivileges=yes
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target

# The JWT signing key is supplied by a root-owned, mode-600 drop-in at
# /etc/systemd/system/whoop-web.service.d/override.conf on opti. That
# drop-in is deliberately NOT checked into this repository.
