[Unit]
Description=Whoop Dashboard (Streamlit)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=george
WorkingDirectory=/home/george/Documents/whoop-dashboard
ExecStart=/home/george/Documents/whoop-dashboard/venv/bin/streamlit run streamlit/app.py --server.headless true
Restart=always
RestartSec=5
MemoryMax=512M
Environment=PATH=/home/george/Documents/whoop-dashboard/venv/bin:/usr/bin

[Install]
WantedBy=multi-user.target
